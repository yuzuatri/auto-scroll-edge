{
  "manifest_version": 3,
  "name": "Simple Auto Scroll",
  "version": "1.0.1",
  "description": "Simple and easy-to-use auto scroll extension for Microsoft Edge",
  "icons": {
    "16": "images/auto-scroll-16.png",
    "32": "images/auto-scroll-32.png",
    "48": "images/auto-scroll-48.png",
    "128": "images/auto-scroll-128.png"
  },
  "action": {
    "default_title": "Auto Scroll",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
